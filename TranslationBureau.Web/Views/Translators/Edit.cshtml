@model TranslationBureau.Application.DTOs.TranslatorInputDto
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Изменение сведений о переводчике";
    var languages = ViewBag.Languages as IEnumerable<SelectListItem> ?? Enumerable.Empty<SelectListItem>();
}

<h2>Изменение сведений о переводчике</h2>

<form asp-action="Edit" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />

    <div class="mb-3">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Category" class="form-label"></label>
        <input asp-for="Category" class="form-control" />
        <span asp-validation-for="Category" class="text-danger"></span>
    </div>
    <div class="mb-3">
    <label asp-for="RatePerUnit" class="form-label"></label>
    <input asp-for="RatePerUnit" type="number" step="0.01" min="0.01" lang="en"
           class="form-control" />
    <span asp-validation-for="RatePerUnit" class="text-danger"></span>
</div>

    <div class="mb-3">
        <label class="form-label">Рабочие языки</label>
        <div class="border rounded p-2">
            @foreach (var lang in languages)
            {
                var isChecked = Model.LanguageIds.Contains(int.Parse(lang.Value));
                <div class="form-check">
                    <input class="form-check-input" type="checkbox"
                           name="LanguageIds" value="@lang.Value"
                           id="lang_@lang.Value"
                           @(isChecked ? "checked" : "") />
                    <label class="form-check-label" for="lang_@lang.Value">
                        @lang.Text
                    </label>
                </div>
            }
        </div>
        <span asp-validation-for="LanguageIds" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Сохранить</button>
    <a asp-action="Index" class="btn btn-secondary">Отмена</a>
</form>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}